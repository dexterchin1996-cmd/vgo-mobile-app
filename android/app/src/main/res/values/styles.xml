<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 基础应用主题 -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- 启动开屏主题 -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme">
        <item name="android:background">@color/vgo_brand_bg</item>
        <item name="android:windowBackground">@color/vgo_brand_bg</item>
        <item name="android:windowSplashScreenBackground">@color/vgo_brand_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_vgo_foreground</item>
    </style>
</resources>
